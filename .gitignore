# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
dist-*/
*.egg
.installed.cfg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# IDE
.idea/
.vscode/
*.swp
*.swo
digital-registrar-research.code-workspace

# OS
.DS_Store
Thumbs.db

# Project — runtime artifacts, never checked in
# Everything under workspace/ is gitignored (data, results, runs, annotations, ckpts).
# Keep .gitkeep files so the skeleton survives a clean checkout.
/workspace/
!/workspace/.gitkeep
!/workspace/**/.gitkeep
ckpts/

# Dummy experiment root — configs/models/README tracked; data/results are generated,
# only the named folder skeleton is kept (via .gitkeep)
/examples/dummy/data/**
/examples/dummy/results/**
!/examples/dummy/data/**/
!/examples/dummy/results/**/
!/examples/dummy/data/**/.gitkeep
!/examples/dummy/results/**/.gitkeep

# Obfustrated workspace — synthetic-from-real, schema-conformant copy for
# debugging eval/ablation/inference paths without exposing PHI. Generated
# on demand by `python scripts/data/obfuscate_workspace.py`. Many MB of synthetic
# data; never commit. Note: NOT added to any Claude-ignore mechanism — Claude
# needs read access for the debugging workflow this is built for.
/workspace_obfustrated/

# Reference test data — symlink staging tree built on demand by
# `--folder reference` (see scripts/_helpers/_config_loader._ensure_reference_staged).
/tests/fixtures/reference/_staged/

# Windows-bundle build artifacts — packaging/ scripts are tracked, outputs are not
/packaging/_downloads/
/packaging/build/
/packaging/dist/

# Annotation tool — per-deployment annotator list (rebuilt from DEFAULTS)
apps/annotator/src/digital_registrar_annotator/annotators.json

# Local configs — machine-specific, never pushed
configs/local/*
!configs/local/.gitkeep

# API keys / secrets
.env
.env.local
*.pem
/secrets/

# Pipeline run outputs (one timestamped dir per invocation) — now under workspace/runs/
# kept here as a fallback for stray /runs/ dirs from older checkouts
/runs/

# Jupyter
.ipynb_checkpoints/
