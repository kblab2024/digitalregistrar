"""Canonical case-model for __ORGAN_KEY__ cancer (Layer 1 of 3).

EDIT THIS FILE FOR:
  - per-field shape (types, optionality, defaults)
  - LowerStrEnum vocabularies (closed sets of allowed values)
  - staging / margin / lymph-node / biomarker spec markers

DO NOT EDIT THIS FILE FOR:
  - LM-facing field descriptions       -> schemas/extraction/__ORGAN_KEY__.py
  - canonical-value surface aliases    -> schemas/aliases/__ORGAN_KEY__.toml
  - the generated JSON snapshot        -> regenerate via `registrar-schemas`

These defaults were scaffolded by `python -m
digital_registrar.schemas.create_organ`. The placeholder enum
values (EXCISION / ADENOCARCINOMA / etc.) are a generic starting point.
Replace them with real __ORGAN_KEY__-specific vocabularies before going
to production.

After editing this file you must also update
``schemas/extraction/__ORGAN_KEY__.py`` to match (any field you add /
remove / rename here needs a corresponding FIELD_META entry there), then
run ``registrar-schemas`` to regenerate ``schemas/data/__ORGAN_KEY__.json``.
"""
from enum import auto
from typing import ClassVar

from pydantic import BaseModel

from ._case_builder import (
    LNSpec,
    MarginSpec,
    StagingSpec,
    assemble_case_model,
)
from ._enums import LowerStrEnum, LymphNodeSide


# --- Closed vocabularies (LowerStrEnum) -----------------------------------
# Each enum's `auto()` generates the lowercase wire-form value. Every set
# ends with NOT_STATED — the explicit "report didn't say" sentinel.


class __CLASS_PREFIX__Procedure(LowerStrEnum):
    EXCISION = auto()
    RESECTION = auto()
    OTHERS = auto()
    NOT_STATED = auto()


class __CLASS_PREFIX__Histology(LowerStrEnum):
    ADENOCARCINOMA = auto()
    SQUAMOUS_CELL_CARCINOMA = auto()
    OTHERS = auto()
    NOT_STATED = auto()


class __CLASS_PREFIX__MarginSite(LowerStrEnum):
    PROXIMAL = auto()
    DISTAL = auto()
    RADIAL = auto()
    OTHERS = auto()
    NOT_STATED = auto()


class __CLASS_PREFIX__LNCategory(LowerStrEnum):
    REGIONAL = auto()
    DISTANT = auto()
    OTHERS = auto()
    NOT_STATED = auto()


# --- Staging enums (one set per organ — copy-paste-and-edit) ---------------


class __CLASS_PREFIX__PT(LowerStrEnum):
    TX = auto()
    T1 = auto()
    T2 = auto()
    T3 = auto()
    T4 = auto()
    NOT_STATED = auto()


class __CLASS_PREFIX__PN(LowerStrEnum):
    NX = auto()
    N0 = auto()
    N1 = auto()
    N2 = auto()
    NOT_STATED = auto()


class __CLASS_PREFIX__StageGroup(LowerStrEnum):
    STAGEI = auto()
    STAGEII = auto()
    STAGEIII = auto()
    STAGEIV = auto()
    NOT_STATED = auto()


# --- Case-model -----------------------------------------------------------
# The @assemble_case_model decorator walks model_fields, expands the spec
# markers (MarginSpec / LNSpec / StagingSpec) into the verbose Pydantic
# shape, and returns the fully-formed BaseModel that the rest of the
# pipeline consumes (DSPy signature builder, JSON-schema generator).


@assemble_case_model()
class __CLASS_PREFIX__CancerCase(BaseModel):
    """Canonical extracted case record for __ORGAN_KEY__ cancer."""

    # --- nonnested ---
    procedure: __CLASS_PREFIX__Procedure | None = None
    histology: __CLASS_PREFIX__Histology | None = None
    tumor_size: int | None = None
    tumor_necrosis: bool | None = None
    lymphovascular_invasion: bool | None = None
    perineural_invasion: bool | None = None
    distant_metastasis: bool | None = None
    treatment_effect: str | None = None

    # --- staging ---
    # StagingSpec emits: tnm_descriptor, pt_category, pn_category,
    # pm_category, <stage groups>, ajcc_version. pm and tnm_descriptor
    # default to the shared PMCategory / TNMDescriptor enums from _enums.
    _STAGING: ClassVar = StagingSpec(
        pt=__CLASS_PREFIX__PT,
        pn=__CLASS_PREFIX__PN,
        stage_groups={"stage_group": __CLASS_PREFIX__StageGroup},
    )

    # --- margins ---
    margins: __CLASS_PREFIX__MarginSite | None = MarginSpec()

    # --- lymph_nodes ---
    regional_lymph_node: __CLASS_PREFIX__LNCategory | None = LNSpec(side=LymphNodeSide)
    extranodal_extension: bool | None = None
    maximal_ln_size: int | None = None
