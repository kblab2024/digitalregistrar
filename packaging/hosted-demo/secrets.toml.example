# Streamlit Cloud secrets template — DO NOT commit a real secrets.toml.
#
# Set these via the Streamlit Cloud dashboard → "Secrets" tab. The
# release workflow refuses to deploy if this file contains values that
# look like real API keys.

OPENAI_API_KEY = "REPLACE_WITH_DEMO_KEY_FROM_STREAMLIT_DASHBOARD"
DEMO_PASSCODE = "OPTIONAL_REPLACE_OR_REMOVE"
DEMO_MODEL = "gpt-4o-mini"
